UIS.TouchStarted:Connect(function(input, gameProcessed)
	if not selectModeActive or not isSyncing then return end
	touchStartPos = Vector2.new(input.Position.X, input.Position.Y)
end)

UIS.TouchEnded:Connect(function(input, gameProcessed)
	if not selectModeActive or not isSyncing then return end
	if not touchStartPos then return end

	local endPos = Vector2.new(input.Position.X, input.Position.Y)
	local moved = (endPos - touchStartPos).Magnitude
	touchStartPos = nil

	if moved > TOUCH_MOVE_THRESHOLD then return end

	local camera = workspace.CurrentCamera
	local ray = camera:ScreenPointToRay(endPos.X, endPos.Y)
	local raycastParams = RaycastParams.new()
	local excluded = {LocalPlayer.Character}
	raycastParams.FilterDescendantsInstances = excluded
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude

	local result = workspace:Raycast(ray.Origin, ray.Direction * 500, raycastParams)
	if result and result.Instance then
		local hit = result.Instance
		local function findBlock(obj)
			if not obj then return nil end
			for id, part in pairs(spawnedBlocks) do
				if part == obj then return part end
			end
			return findBlock(obj.Parent)
		end
		local found = findBlock(hit)
		if found then
			selectedPart = found
			createHandlesForPart(selectedPart)
			InfoLabel.Text = "Выбран: " .. string.sub(selectedPart.Name, 11, 22)
			tweenProp(InfoLabel, {TextColor3 = Color3.fromRGB(0, 200, 120)}, TWEEN_FAST)
			currentBlockColor = selectedPart.Color
			updateColorPreviewAnim(currentBlockColor)
			currentH, currentS, currentV = Color3.toHSV(currentBlockColor)
			updatePaletteColor()
			selectModeActive = false
			tweenProp(SelectBtn, {BackgroundColor3 = Color3.fromRGB(30, 100, 180)}, TWEEN_MED)
			SelectBtn.Text = "ВЫБРАТЬ БЛОК (нажми на блок)"
		end
	end
end)

