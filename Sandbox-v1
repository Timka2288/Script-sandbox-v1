local SHAPE_TO_PARTTYPE = {
	Cube     = Enum.PartType.Block,
	Cylinder = Enum.PartType.Cylinder,
	Sphere   = Enum.PartType.Ball,
	Wedge    = "Wedge",
}

local function createPartFromInfo(id, info)
	local part
	local shapeStr = (info.shape or "Cube")
	if shapeStr == "Wedge" then
		part = Instance.new("WedgePart")
	else
		part = Instance.new("Part")
		local pt = SHAPE_TO_PARTTYPE[shapeStr]
		if pt and pt ~= "Wedge" then
			part.Shape = pt
		end
	end
	part.Name = "SyncBlock_" .. id
	part.Anchored = true
	part.CanCollide = true
	part.Size  = Vector3.new(info.size.x, info.size.y, info.size.z)
	part.Color = Color3.fromRGB(info.color.r, info.color.g, info.color.b)
	local pos = Vector3.new(info.position.x, info.position.y, info.position.z)
	if info.rotation then
		local rx = math.rad(info.rotation.x or 0)
		local ry = math.rad(info.rotation.y or 0)
		local rz = math.rad(info.rotation.z or 0)
		part.CFrame = CFrame.new(pos) * CFrame.Angles(rx, ry, rz)
	else
		part.Position = pos
	end
	part.Parent = workspace
	return part
end

local function startSynchronization()
	task.spawn(function()
		while isSyncing do
			pcall(function()
				if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
					local myPos = LocalPlayer.Character.HumanoidRootPart.Position
					local res = request({
						Url = SERVER_URL .. "/update",
						Method = "POST",
						Headers = {["Content-Type"] = "application/json"},
						Body = HttpService:JSONEncode({
							username = LocalPlayer.Name,
							position = {x = myPos.X, y = myPos.Y, z = myPos.Z}
						})
					})
					if res.StatusCode == 200 then
						local ok, serverData = pcall(HttpService.JSONDecode, HttpService, res.Body)
						if ok and serverData.players then
							for name, pos in pairs(serverData.players) do
								if name ~= LocalPlayer.Name then
									local marker = remotePlayersMarkers[name]
									if not marker then
										marker = Instance.new("Part")
										marker.Shape = Enum.PartType.Ball
										marker.Size  = Vector3.new(3,3,3)
										marker.Color = Color3.fromRGB(0,255,200)
										marker.Material = Enum.Material.Neon
										marker.Transparency = 0.4
										marker.Anchored = true
										marker.CanCollide = false
										marker.Parent = workspace
										remotePlayersMarkers[name] = marker
									end
									marker.Position = Vector3.new(pos.x, pos.y+3, pos.z)
								end
							end
						end
					end
				end

				local bRes = request({Url = SERVER_URL .. "/get_blocks", Method = "GET"})
				if bRes.StatusCode == 200 then
					local ok, serverBlocks = pcall(HttpService.JSONDecode, HttpService, bRes.Body)
					if not ok then return end

					for id, part in pairs(spawnedBlocks) do
						if not serverBlocks[id] then
							if selectedPart == part then destroyHandles(); selectedPart = nil end
							part:Destroy()
							spawnedBlocks[id] = nil
						end
					end

					for id, info in pairs(serverBlocks) do
						local part = spawnedBlocks[id]
						if not part then
							part = createPartFromInfo(id, info)
							spawnedBlocks[id] = part
						elseif selectedPart ~= part then
							local newPos = Vector3.new(info.position.x, info.position.y, info.position.z)
							part.Size  = Vector3.new(info.size.x, info.size.y, info.size.z)
							part.Color = Color3.fromRGB(info.color.r, info.color.g, info.color.b)
							if info.rotation then
								local rx = math.rad(info.rotation.x or 0)
								local ry = math.rad(info.rotation.y or 0)
								local rz = math.rad(info.rotation.z or 0)
								part.CFrame = CFrame.new(newPos) * CFrame.Angles(rx, ry, rz)
							else
								part.Position = newPos
							end
						end
					end
				end
			end)
			task.wait(0.2)
		end
	end)
end

