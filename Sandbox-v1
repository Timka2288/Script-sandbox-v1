function syncBlockToServer(part)
	local cleanId = string.gsub(part.Name, "SyncBlock_", "")
	local pos = part.Position
	local sz  = part.Size
	local col = part.Color
	local rx, ry, rz = part.CFrame:ToEulerAnglesXYZ()
	pcall(function()
		request({
			Url = SERVER_URL .. "/update_block",
			Method = "POST",
			Headers = {["Content-Type"] = "application/json"},
			Body = HttpService:JSONEncode({
				id = cleanId,
				updates = {
					position = {x=pos.X, y=pos.Y, z=pos.Z},
					size     = {x=sz.X,  y=sz.Y,  z=sz.Z},
					rotation = {x=math.deg(rx), y=math.deg(ry), z=math.deg(rz)},
					color    = {
						r=math.floor(col.R*255),
						g=math.floor(col.G*255),
						b=math.floor(col.B*255)
					}
				}
			})
		})
	end)
end

local function destroyHandles()
	if currentHandles     then currentHandles:Destroy();     currentHandles     = nil end
	if currentSizeHandles then currentSizeHandles:Destroy(); currentSizeHandles = nil end
	if currentRotHandles  then currentRotHandles:Destroy();  currentRotHandles  = nil end
	for _, obj in ipairs(workspace:GetChildren()) do
		if obj.Name and string.sub(obj.Name, 1, 9) == "RotProxy_" then
			pcall(function() obj:Destroy() end)
		end
	end
end

local function createHandlesForPart(part)
	destroyHandles()

	local rotProxy
	local moveH = Instance.new("Handles")
	moveH.Color3 = Color3.fromRGB(255, 220, 0)
	moveH.Adornee = part
	moveH.Style = Enum.HandlesStyle.Movement
	moveH.Parent = CoreGui
	currentHandles = moveH

	local startPos = part.Position
	moveH.MouseButton1Down:Connect(function()
		startPos = part.Position
	end)
	moveH.MouseDrag:Connect(function(face, distance)
		local localNormal = FACE_TO_NORMAL[face] or Vector3.new(0,0,0)
		local worldNormal = part.CFrame:VectorToWorldSpace(localNormal).Unit
		local newPos = startPos + worldNormal * distance
		part.CFrame = CFrame.new(newPos) * part.CFrame.Rotation
		if rotProxy then rotProxy.CFrame = part.CFrame end
	end)
	moveH.MouseButton1Up:Connect(function()
		startPos = part.Position
		if rotProxy then rotProxy.CFrame = part.CFrame end
		syncBlockToServer(part)
	end)

	local sizeH = Instance.new("Handles")
	sizeH.Color3 = Color3.fromRGB(0, 200, 255)
	sizeH.Adornee = part
	sizeH.Style = Enum.HandlesStyle.Resize
	sizeH.Parent = CoreGui
	currentSizeHandles = sizeH

	local startSize = part.Size
	local startPos = part.Position
	sizeH.MouseButton1Down:Connect(function()
		startSize = part.Size
		startPos = part.Position
	end)
	sizeH.MouseDrag:Connect(function(face, distance)
		local normal = FACE_TO_NORMAL[face] or Vector3.new(0,0,0)
		local absNormal = Vector3.new(math.abs(normal.X), math.abs(normal.Y), math.abs(normal.Z))
		if toggleSymScale then
			local delta = absNormal * distance * 2
			local newSize = Vector3.new(
				math.max(0.5, startSize.X + delta.X),
				math.max(0.5, startSize.Y + delta.Y),
				math.max(0.5, startSize.Z + delta.Z)
			)
			part.Size = newSize
			part.CFrame = CFrame.new(startPos) * part.CFrame.Rotation
		else
			local delta = absNormal * distance
			local newSize = Vector3.new(
				math.max(0.5, startSize.X + delta.X),
				math.max(0.5, startSize.Y + delta.Y),
				math.max(0.5, startSize.Z + delta.Z)
			)
			part.Size = newSize
			local actualDelta = newSize - startSize
			local worldNormal = part.CFrame:VectorToWorldSpace(normal).Unit
			local shift = (actualDelta.X + actualDelta.Y + actualDelta.Z) * 0.5
			part.CFrame = CFrame.new(startPos + worldNormal * shift) * part.CFrame.Rotation
		end
		local newSize = part.Size
		if rotProxy then
			rotProxy.Size = newSize + Vector3.new(5, 5, 5)
			rotProxy.CFrame = part.CFrame
		end
	end)
	sizeH.MouseButton1Up:Connect(function()
		startSize = part.Size
		if rotProxy then
			rotProxy.Size = part.Size + Vector3.new(5, 5, 5)
			rotProxy.CFrame = part.CFrame
		end
		syncBlockToServer(part)
	end)

	rotProxy = Instance.new("Part")
	rotProxy.Size = part.Size + Vector3.new(5, 5, 5)
	rotProxy.CFrame = part.CFrame
	rotProxy.Anchored = true
	rotProxy.CanCollide = false
	rotProxy.CanTouch = false
	rotProxy.CanQuery = false
	rotProxy.Transparency = 1
	rotProxy.CastShadow = false
	rotProxy.Name = "RotProxy_" .. part.Name
	rotProxy.Parent = workspace
	currentRotHandles = Instance.new("ArcHandles")
	currentRotHandles.Color3 = Color3.fromRGB(0, 220, 100)
	currentRotHandles.Adornee = rotProxy
	currentRotHandles.Axes = Axes.new(Enum.Axis.X, Enum.Axis.Y, Enum.Axis.Z)
	currentRotHandles.Parent = CoreGui

	local startCFrame = part.CFrame
	currentRotHandles.MouseButton1Down:Connect(function()
		startCFrame = part.CFrame
	end)
	currentRotHandles.MouseDrag:Connect(function(axis, relativeAngle)
		if axis == Enum.Axis.X then
			part.CFrame = startCFrame * CFrame.Angles(relativeAngle, 0, 0)
		elseif axis == Enum.Axis.Y then
			part.CFrame = startCFrame * CFrame.Angles(0, relativeAngle, 0)
		elseif axis == Enum.Axis.Z then
			part.CFrame = startCFrame * CFrame.Angles(0, 0, relativeAngle)
		end
		rotProxy.CFrame = part.CFrame
	end)
	currentRotHandles.MouseButton1Up:Connect(function()
		startCFrame = part.CFrame
		rotProxy.CFrame = part.CFrame
		syncBlockToServer(part)
	end)
	currentRotHandles.AncestryChanged:Connect(function(_, newParent)
		if newParent == nil then
			pcall(function() rotProxy:Destroy() end)
		end
	end)
end

