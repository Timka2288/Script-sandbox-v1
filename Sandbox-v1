local TWEEN_FAST   = TweenInfo.new(0.18, Enum.EasingStyle.Quad,   Enum.EasingDirection.Out)
local TWEEN_MED    = TweenInfo.new(0.28, Enum.EasingStyle.Quint,  Enum.EasingDirection.Out)
local TWEEN_SPRING = TweenInfo.new(0.35, Enum.EasingStyle.Back,   Enum.EasingDirection.Out)
local TWEEN_BOUNCE = TweenInfo.new(0.40, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out)

local function tweenProp(obj, props, info)
	TweenService:Create(obj, info or TWEEN_MED, props):Play()
end

local function addButtonAnim(btn, normalColor)
	local origSize = btn.Size
	local origPos  = btn.Position
	local currentNormal = normalColor
	local activeTween = nil

	local function sizeForFactor(f)
		local dw = origSize.X.Offset * (f - 1)
		local dh = origSize.Y.Offset * (f - 1)
		return
			UDim2.new(origSize.X.Scale, origSize.X.Offset + dw,
			          origSize.Y.Scale, origSize.Y.Offset + dh),
			UDim2.new(origPos.X.Scale,  origPos.X.Offset  - dw * 0.5,
			          origPos.Y.Scale,  origPos.Y.Offset  - dh * 0.5)
	end

	local function playTween(obj, props, info)
		if activeTween then activeTween:Cancel() end
		local t = TweenService:Create(obj, info or TWEEN_MED, props)
		activeTween = t
		t:Play()
	end

	btn.MouseEnter:Connect(function()
		local s, p = sizeForFactor(1.03)
		playTween(btn, {BackgroundColor3 = currentNormal:Lerp(Color3.new(1,1,1), 0.10), Size = s, Position = p}, TWEEN_FAST)
	end)
	btn.MouseLeave:Connect(function()
		playTween(btn, {BackgroundColor3 = currentNormal, Size = origSize, Position = origPos}, TWEEN_FAST)
	end)
	btn.MouseButton1Down:Connect(function()
		local s, p = sizeForFactor(0.97)
		playTween(btn, {BackgroundColor3 = currentNormal:Lerp(Color3.new(0,0,0), 0.15), Size = s, Position = p}, TWEEN_FAST)
	end)
	btn.MouseButton1Up:Connect(function()
		playTween(btn, {BackgroundColor3 = currentNormal, Size = origSize, Position = origPos}, TWEEN_SPRING)
	end)

	return function(newColor)
		currentNormal = newColor
		if activeTween then activeTween:Cancel() end
		btn.BackgroundColor3 = newColor
	end
end

